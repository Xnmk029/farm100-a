{
  "name": "farm100", "version": "0.5.4-alpha.1", "private": true, "type": "module",
  "description": "可复现的算法农场基准测试桌面客户端",
  "author": "FARM100", "license": "GPL-3.0-only",
  "repository": {"type": "git", "url": "https://github.com/Xnmk029/farm100-a.git"},
  "main": "dist/main.cjs", "packageManager": "pnpm@11.22.0",
  "engines": {"node": ">=24"},
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "qa:fleet": "tsx scripts/fleet-qa.ts --full",
    "qa:challenges": "tsx scripts/challenge-qa.ts --full",
    "benchmark:v2": "tsx scripts/benchmark-v2-run.ts",
    "agent": "node scripts/farm100-agent.mjs",
    "agent:prepare": "node scripts/farm100-agent.mjs prepare",
    "agent:mcp": "node scripts/farm100-agent.mjs mcp",
    "score:challenges": "tsx scripts/score-challenge-suite.ts",
    "qa:economy": "tsx scripts/economy-qa.ts",
    "qa:utility": "pnpm build && electron . --qa-utility",
    "batch": "tsx scripts/batch.ts",
    "package": "pnpm build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "quickjs-emscripten": "0.32.0", "pixi.js": "8.20.1",
    "react": "19.2.8", "react-dom": "19.2.8", "monaco-editor": "0.55.1", "zod": "4.3.6"
  },
  "devDependencies": {
    "electron": "44.2.0", "electron-builder": "26.15.3", "vite": "8.2.2",
    "typescript": "5.9.3", "tsx": "4.21.0", "esbuild": "0.27.3",
    "@types/node": "24.10.13", "@types/react": "19.2.14", "@types/react-dom": "19.2.3"
  },
  "build": {
    "appId": "local.farm100.desktop", "productName": "FARM100",
    "electronDist": "node_modules/electron/dist",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "examples/**/*", "scenarios/**/*", "package.json"],
    "asarUnpack": ["**/*.wasm"],
    "win": {"target": "nsis", "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true}
  }
}
